[
  {
    "kind": "tm:ltm:virtual:virtualstate",
    "name": "vs-web",
    "partition": "Common",
    "fullPath": "/Common/vs-web",
    "destination": "/Common/192.0.2.10:443",
    "pool": "/Common/pool-web",
    "rules": [
      "/Common/irule-static"
    ],
    "enabled": true
  },
  {
    "kind": "tm:ltm:virtual:virtualstate",
    "name": "vs-idle",
    "partition": "Common",
    "fullPath": "/Common/vs-idle",
    "destination": "/Common/192.0.2.11:80",
    "pool": "/Common/pool-idle",
    "enabled": true
  },
  {
    "kind": "tm:ltm:virtual:virtualstate",
    "name": "vs-dead",
    "partition": "Common",
    "fullPath": "/Common/vs-dead",
    "destination": "/Common/192.0.2.13:443",
    "pool": "/Common/pool-dead",
    "enabled": true,
    "mask": "255.255.255.255",
    "ipProtocol": "tcp",
    "source": "0.0.0.0/0",
    "persist": [
      {
        "name": "cookie",
        "partition": "Common",
        "tmDefault": "yes"
      }
    ],
    "fallbackPersistence": "/Common/source_addr",
    "sourceAddressTranslation": {
      "type": "snat",
      "pool": "/Common/snat-example"
    },
    "vlansEnabled": true,
    "vlans": [
      "/Common/vlan-external"
    ],
    "translateAddress": "enabled",
    "translatePort": "enabled",
    "description": "Decommissioned app example.net"
  },
  {
    "kind": "tm:ltm:virtual:virtualstate",
    "name": "vs-disabled",
    "partition": "Common",
    "fullPath": "/Common/vs-disabled",
    "destination": "/Common/192.0.2.12:80",
    "pool": "/Common/pool-web",
    "disabled": true
  }
]
